{
  "name": "@subsy/gardener",
  "version": "0.1.0",
  "description": "Measure whether a fast-moving, agent-written codebase is getting healthier, from git history alone.",
  "type": "module",
  "bin": {
    "gardener": "./src/cli.mjs"
  },
  "files": [
    "src/*.mjs",
    "!src/*.test.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "node --test 'src/*.test.mjs'"
  },
  "keywords": [
    "code-health",
    "technical-debt",
    "git",
    "hotspots",
    "ai-agents",
    "claude-code",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subsy/gardener.git"
  },
  "license": "MIT"
}
